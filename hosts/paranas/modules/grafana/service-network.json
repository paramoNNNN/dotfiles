{
  "uid": "service-network",
  "title": "Service Network Traffic",
  "tags": [
    "network",
    "nginx",
    "lan"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"service_network_bytes_total|service_nginx_http_response_count_total\"}, service)",
          "refId": "service"
        },
        "definition": "label_values({__name__=~\"service_network_bytes_total|service_nginx_http_response_count_total\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "network",
        "label": "Network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"service_network_bytes_total|service_nginx_http_response_count_total\"}, network)",
          "refId": "network"
        },
        "definition": "label_values({__name__=~\"service_network_bytes_total|service_nginx_http_response_count_total\"}, network)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "vhost",
        "label": "Vhost",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(service_nginx_http_response_count_total, vhost)",
          "refId": "vhost"
        },
        "definition": "label_values(service_nginx_http_response_count_total, vhost)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Traffic scope",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Nginx routes** show traffic per service and hostname, split by socket peer: external, private LAN, loopback, or overlay_or_cgnat. **Live service counters** classify Tailscale by interface and show client-facing ports, excluding loopback. Long downloads/WebSockets appear per route only after closing. These two measurements overlap and must not be added.\n\nLAN clients can use external hostnames. CDN/router proxying or hairpin NAT can hide the original client; forwarded headers are not trusted. Direct counters do not attribute arbitrary outbound calls or private container traffic. Host interface totals provide context."
      }
    },
    {
      "id": 1,
      "title": "Nginx download by service and client network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "HTTP body download / full HTTP request upload bytes. Updated when requests finish. Includes nginx routes for native and Docker services.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (rate(service_nginx_http_response_size_bytes{service=~\"$service\",network=~\"$network\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Nginx upload by service and client network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "HTTP body download / full HTTP request upload bytes. Updated when requests finish. Includes nginx routes for native and Docker services.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (rate(service_nginx_http_request_size_bytes{service=~\"$service\",network=~\"$network\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Live service transmit by peer network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live IP bytes, including TCP/TLS overhead. nginx is the combined HTTP/HTTPS entrypoint. Other services are direct connections. Loopback proxy backend traffic is excluded; do not add to nginx route metrics.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (rate(service_network_bytes_total{service=~\"$service\",network=~\"$network\",direction=\"transmit\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Live service receive by peer network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live IP bytes, including TCP/TLS overhead. nginx is the combined HTTP/HTTPS entrypoint. Other services are direct connections. Loopback proxy backend traffic is excluded; do not add to nginx route metrics.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (rate(service_network_bytes_total{service=~\"$service\",network=~\"$network\",direction=\"receive\"}[$__rate_interval]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Nginx download volume over selected time",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Completed requests in the selected time window. Retention: seven days.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (increase(service_nginx_http_response_size_bytes{service=~\"$service\",network=~\"$network\"}[$__range]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Nginx upload volume over selected time",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Completed requests in the selected time window. Retention: seven days.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, network) (increase(service_nginx_http_request_size_bytes{service=~\"$service\",network=~\"$network\"}[$__range]))",
          "legendFormat": "{{service}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Nginx route bandwidth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Response body throughput for each configured nginx hostname, including LAN clients that use that hostname.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vhost, network) (rate(service_nginx_http_response_size_bytes{service=~\"$service\",network=~\"$network\",vhost=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "{{vhost}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Nginx requests by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vhost, network) (rate(service_nginx_http_response_count_total{service=~\"$service\",network=~\"$network\",vhost=~\"$vhost\"}[$__rate_interval]))",
          "legendFormat": "{{vhost}} / {{network}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Host interface bandwidth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Host totals include untracked services and outbound connections. Tailscale and physical interfaces overlap; do not sum them.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{job=\"node\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} receive",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{job=\"node\",device!~\"lo|veth.*|docker.*|br-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} transmit",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Collection health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Counter age should usually be under 45 seconds. Exporter up should be 1; parse errors should stay at zero. An idle service has no nginx series until its first completed request.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - service_network_collector_timestamp_seconds",
          "legendFormat": "Live counter age",
          "range": true
        },
        {
          "refId": "B",
          "expr": "up{job=\"nginx-traffic\"}",
          "legendFormat": "Nginx exporter up (1=yes)",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(service_nginx_parse_errors_total)",
          "legendFormat": "Nginx parse errors",
          "range": true
        }
      ]
    }
  ]
}
